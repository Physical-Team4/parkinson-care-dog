# 변수 이름만 적습니다. 값은 각자 .env에 채우고, .env는 절대 커밋하지 마세요.
# 새 변수가 필요하면 여기에 이름만 추가하고 docs/setup.md에 설명을 적어 주세요.

# ── Supabase ──
SUPABASE_URL=
# 대시보드용 (anon / publishable 키). 로그인 전에는 아무것도 못 읽음 (RLS)
SUPABASE_ANON_KEY=
# Pi 전용 (service_role / secret 키). RLS를 우회하므로 Pi의 .env에만, 대시보드·프론트엔드에 절대 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 적용용 DB 접속 문자열 (비밀번호 포함). 필요한 사람만
SUPABASE_DB_URL=
# 대시보드 데이터 소스: supabase | mock. 비우면 SUPABASE_URL·SUPABASE_ANON_KEY가 있으면 supabase, 없으면 mock
DASHBOARD_DATA_SOURCE=
# 대시보드 개발용 자동 로그인 (python server.py --dev-login, 127.0.0.1에서만). 테스트 계정만, 실제 계정 금지
DASHBOARD_DEV_EMAIL=
DASHBOARD_DEV_PASSWORD=

# ── 보호자 메신저 알림 (메신저 종류 미확정, 예: Telegram) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 하드웨어 ──
ESP32_SERIAL_PORT=
ESP32_SERIAL_BAUD=
# true로 두면 하드웨어·인터넷 없이 mock adapter로 실행
PD_DOG_MOCK_HARDWARE=
# X1200 GPIO6(전원 차단 감지)에서 외부 전원이 있을 때 읽히는 값 0/1. 비우면 감지 끔 (docs/setup.md 2-6에서 실측)
X1200_PLD_POWER_OK_LEVEL=
# true면 외부 전원(충전기)이 빠졌을 때도 안전 종료. 기본 false (배터리 주행이 평소 상태)
PI_SHUTDOWN_ON_POWER_LOSS=

# ── Pi 로컬 저장 위치 ──
# 오프라인 대기열 SQLite (기본 ~/pd-dog-data/outbox.db)
PD_DOG_QUEUE_PATH=
PD_DOG_LOG_DIR=
PD_DOG_MODEL_DIR=
# F6·F7 pose 모델 .hef (PD_DOG_MODEL_DIR 기준 상대 경로 가능, 예: hailo8l/yolov8s_pose.hef). 비우면 비전 끔
POSE_HEF=
# 카메라 장착 방향 보정 true/false. 거꾸로 달았으면 둘 다 true (180° 회전)
CAMERA_HFLIP=
CAMERA_VFLIP=
# 로봇 이동 마커: 인쇄한 마커 한 변(cm), 카메라 초점거리(px, marker_test --at-cm로 측정). 비우면 거리·방향 추정 끔
MARKER_SIZE_CM=
CAMERA_FOCAL_PX=
# 잠자리 마커 번호(쉼표로 여러 개)와 취침 시간대. 둘 다 있어야 동작 (예: SLEEP_MARKER_IDS=10, SLEEP_HOURS=22:00-07:00)
SLEEP_MARKER_IDS=
SLEEP_HOURS=
