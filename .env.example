# 변수 이름만 적습니다. 값은 각자 .env에 채우고, .env는 절대 커밋하지 마세요.
# 새 변수가 필요하면 여기에 이름만 추가하고 docs/setup.md에 설명을 적어 주세요.

# ── Supabase ──
SUPABASE_URL=
# 대시보드용 (anon / publishable 키). 로그인 전에는 아무것도 못 읽음 (RLS)
SUPABASE_ANON_KEY=
# Pi 전용 (service_role / secret 키). RLS를 우회하므로 Pi의 .env에만, 대시보드·프론트엔드에 절대 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
# 마이그레이션 적용용 DB 접속 문자열 (비밀번호 포함). 필요한 사람만
SUPABASE_DB_URL=

# ── 보호자 메신저 알림 (메신저 종류 미확정, 예: Telegram) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 하드웨어 ──
ESP32_SERIAL_PORT=
ESP32_SERIAL_BAUD=
# true로 두면 하드웨어·인터넷 없이 mock adapter로 실행
PD_DOG_MOCK_HARDWARE=

# ── Pi 로컬 저장 위치 ──
# 오프라인 대기열 SQLite (기본 ~/pd-dog-data/outbox.db)
PD_DOG_QUEUE_PATH=
PD_DOG_LOG_DIR=
PD_DOG_MODEL_DIR=
